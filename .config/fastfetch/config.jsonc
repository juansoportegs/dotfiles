{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "kitty-direct",
    "source": "/home/user0/Pictures/archlinux.png",
    "width": 28,
    "height": 14,
    "padding": {
      "top": 1,
      "right": 3
    }
  },

  "display": {
    "separator": " ➜ "
  },

  "modules": [
    "break",

    {
      "type": "title",
      "format": "{user-name}@{host-name}",
      "color": {
        "user": "cyan",
        "host": "blue"
      }
    },

    "break",

    {
      "type": "os",
      "key": "󰣇 OS",
      "keyColor": "yellow"
    },
    {
      "type": "command",
      "key": "├󰅐 OS Age",
      "keyColor": "yellow",
      "text": "echo $(( ( $(date +%s) - $(stat -c %W /) ) / 86400 )) days"
    },
    {
      "type": "kernel",
      "key": "├󰒋",
      "keyColor": "yellow"
    },
    {
      "type": "packages",
      "key": "├󰏖",
      "keyColor": "yellow"
    },
    {
      "type": "shell",
      "key": "├",
      "keyColor": "yellow"
    },
    {
      "type": "terminal",
      "key": "├",
      "keyColor": "yellow"
    },
    {
      "type": "wm",
      "key": "└󰧨",
      "keyColor": "yellow"
    },

    "break",

    {
      "type": "host",
      "key": "󰌢 SYSTEM",
      "keyColor": "green"
    },
    {
      "type": "cpu",
      "key": "├󰻠",
      "keyColor": "green"
    },
    {
      "type": "gpu",
      "key": "├󰻑",
      "format": "{2}",
      "keyColor": "green"
    },
    {
      "type": "display",
      "key": "├󰍹",
      "compactType": "original-with-refresh-rate",
      "keyColor": "green"
    },
    {
      "type": "memory",
      "key": "├󰾆",
      "keyColor": "green"
    },
    {
      "type": "swap",
      "key": "├󰓡",
      "keyColor": "green"
    },
    {
      "type": "uptime",
      "key": "└󰅐",
      "keyColor": "green"
    },

    "break",

    {
      "type": "colors",
      "paddingLeft": 2
    }
  ]
}