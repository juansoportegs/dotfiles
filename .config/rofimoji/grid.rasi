@import "config"
@theme "/home/user0/.config/rofi/themes/tokyonight.rasi"

window {
  location: center;
  anchor: center;
  width: 58%;
  padding: 18px;
}

mainbox {
  spacing: 14px;
  background-color: @bg;
  children: [ inputbar, listview ];
}

inputbar {
  padding: 12px 16px;
  margin: 0 0 4px 0;
  border-radius: 12px;
  background-color: @bg2;
  children: [ entry ];
}

entry {
  background-color: transparent;
  text-color: @fg;
  placeholder: "Buscar emoji...";
  placeholder-color: @dim;
  font: "JetBrainsMono Nerd Font 14";
}

listview {
  columns: 3;
  lines: 6;
  spacing: 8px;
  cycle: true;
  dynamic: true;
  layout: vertical;
  flow: horizontal;
  fixed-height: true;
  fixed-columns: true;
  scrollbar: false;
  background-color: @bg;
}

element {
  orientation: vertical;
  padding: 10px;
  spacing: 4px;
  border-radius: 12px;
  background-color: transparent;
  text-color: @fg;
}

element selected {
  background-color: @sel;
  text-color: @cyan;
}

element-icon {
  size: 44px;
  margin: 4px 0 2px 0;
  background-color: transparent;
  vertical-align: 0.5;
  horizontal-align: 0.5;
}

element-text {
  background-color: transparent;
  text-color: @fg;
  font: "JetBrainsMono Nerd Font 11";
  horizontal-align: 0.5;
}

element selected element-text {
  text-color: @cyan;
}
