fastfetch

# Aliases
alias i='sudo pacman -S'
alias syu='topgrade --disable firmware restarts --no-retry'
alias ls='ls --color=auto'
alias ll='ls -lah'
alias la='ls -A'
alias grep='grep --color=auto'

# Lines configured by zsh-newuser-install
HISTFILE=~/.histfile
HISTSIZE=1000
SAVEHIST=1000
bindkey -e
# End of lines configured by zsh-newuser-install
# The following lines were added by compinstall
zstyle :compinstall filename '/home/user0/.zshrc'

autoload -Uz compinit
compinit
# End of lines added by compinstall

# Nicer prompt with colors and git status
autoload -Uz vcs_info
precmd() {
  vcs_info
}
zstyle ':vcs_info:git:*' formats ' (%F{magenta)%b%f)'
setopt PROMPT_SUBST
PROMPT='%F{green}%n%f@%F{yellow}%m%f %F{blue}%~%f${vcs_info_msg_0_}
%# '

# opencode
export PATH=/home/user0/.opencode/bin:$PATH
